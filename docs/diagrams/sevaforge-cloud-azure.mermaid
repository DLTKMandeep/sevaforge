  classDef layer7 fill:#E0F2F1,stroke:#00897B,stroke-width:2px,color:#004D40
  classDef layer8 fill:#E1F5FE,stroke:#0288D1,stroke-width:2px,color:#01579B
  classDef layer9 fill:#ECEFF1,stroke:#546E7A,stroke-width:2px,color:#263238

  class CLI,SHELL,IDE,CICD_T,API_C,CHAT layer1
  class AFD,WAF,ENTRA,APIM layer2
  class MC,MR,RAG,INTENT,SB layer3
  class PS,DA,TA,HA,CE,SS,RB,MORE layer4
