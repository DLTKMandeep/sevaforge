---
title: "SevaForge v3.0 — Cloud Architecture (Azure)"
---
graph TB
  %% ════════════════════════════════════════════════════════
  %% LAYER 1 — Client / Developer Interface
  %% ════════════════════════════════════════════════════════
  subgraph L1["🖥️ LAYER 1 — Client / Developer Interface"]
    direction LR
    CLI["forgeflow CLI\n(Click + Rich)"]
    SHELL["Azure Cloud Shell\nBash / PowerShell"]
    IDE["VS Code\n+ Azure Extension"]
    CICD_T["Azure DevOps\n+ ArgoCD"]
    API_C["REST API\nPostman / SDK"]
    CHAT["Teams / ChatOps\nSignalR + Bot FW"]
  end

  subgraph L2["🌐 LAYER 2 — Ingress / API Gateway"]
    direction LR
    AFD["Azure Front Door\nGlobal LB + CDN + SSL"]
    WAF["Azure WAF\nDDoS Protection + OWASP"]
    ENTRA["Entra ID (Azure AD)\nOAuth 2.0 + RBAC + MFA"]
    APIM["API Management\nRate limiting + policies"]
  end

  subgraph L3["🎯 LAYER 3 — Orchestration (AKS + KEDA)"]
    direction LR
    MC["MissionControl\nPipeline Orchestrator\n(AKS Deployment)"]
    MR["ModelRouter\nLLM Traffic Manager\n(cost + latency)"]
    RAG["RAGPipeline\nVector Search + Hybrid\n(Azure PG pgvector)"]
    INTENT["Config / Intent\ndeployment-intent.yaml\n(Blob + ConfigMap)"]
    SB["Service Bus\n+ Event Grid\n(async stages)"]
  end

  subgraph L4["🤖 LAYER 4 — Pipeline Agents (AKS — KEDA Scaled)"]
    direction LR
    PS["ProjectScanner\nLanguage detect\n+ LLM classify"]
    DA["DockerAgent\nDockerfile gen\n+ LLM optimize"]
    TA["TerraformAgent\nIaC generation\n+ LLM modules"]
    HA["HelmAgent\nK8s manifests\n+ LLM values"]
    CE["CostEstimator\nAzure Pricing API\n+ LLM budget"]
    SS["SecurityScanner\nDefender + Sentinel\n+ LLM triage"]
    RB["RunbookAgent\nOps docs gen\n+ LLM author"]
    MORE["+ 7 More\nMonitoring, CI/CD\nCompliance, Net..."]
  end

  subgraph L5["🧠 LAYER 5 — AI Gateway (Azure OpenAI Service)"]
    direction LR
    MR_SVC["ModelRouter Service\nCost-aware routing"]
    AOAI["Azure OpenAI Endpoints\nPTU + pay-as-you-go"]
    GUARD["Content Safety\nResponsible AI filters"]
    AZML["Azure ML Pipelines\nML workflow orch."]
  end

  subgraph L6["☁️ LAYER 6 — External AI (Azure AI Catalog)"]
    direction LR
    CLAUDE["Claude 3.5 (MaaS)\nReasoning + Code Gen"]
    GPT4O["GPT-4o\nLong-context analysis"]
    GPT4M["GPT-4o-mini\nFast classify"]
    EMBED["text-embedding-3-large\n3072-dim vectors"]
    COPILOT["GitHub Copilot API\nCode-specific"]
  end

  subgraph L7["🔌 LAYER 7 — MCP Servers (AKS Sidecars)"]
    direction LR
    FS_MCP["filesystem-mcp\nBlob + Azure Files"]
    DOCK_MCP["docker-mcp\nDevOps Build\n+ ACR Registry"]
    TF_MCP["terraform-mcp\nTF Cloud\nBlob remote state"]
    VS_MCP["vector-store-mcp\nAzure PG pgvector"]
    EM_MCP["embedding-mcp\nAzure OpenAI Embed"]
    AO_MCP["azure-openai-mcp\nOpenAI Service API"]
    MORE_MCP["+ 3 MCPs\ngit, helm, secrets"]
  end

  subgraph L8["💾 LAYER 8 — Data & Vector Storage (Managed)"]
    direction LR
    AZPG["Azure DB PostgreSQL\nFlexible + pgvector\nEmbeddings + metadata"]
    REDIS["Azure Cache Redis\nSession + pipeline cache\nLLM response cache"]
    BLOB["Blob Storage\nArtifacts + templates\nTerraform state"]
    SYNAPSE["Synapse Analytics\nPipeline analytics\nCost tracking"]
    KV["Key Vault\nAPI keys + certs\nManaged identity"]
  end

  subgraph L9["⚙️ LAYER 9 — Infrastructure (Azure Managed)"]
    direction LR
    AKS["AKS + KEDA\nEvent-driven scaling\nManaged Identity"]
    ADO["Azure DevOps\nCI/CD pipelines\n+ ACR Registry"]
    ARGO["ArgoCD / Flux\nGitOps delivery\nAKS GitOps"]
    MON["Azure Monitor\nApp Insights + Logs\nDistributed tracing"]
    VNET["VNet + Private EP\nNetwork isolation\nNSG + Private Link"]
    IAC["Terraform + Bicep\nIaC provisioning\nBlob remote state"]
  end

  L1 --> L2
  L2 --> L3
  L3 --> L4
  L4 --> L5
  L5 --> L6
  L4 --> L7
  L7 --> L8
  L8 --> L9

  L3 -.->|"RAG context"| L8
  L5 -.->|"cached responses"| L8
  L7 -.->|"tool results"| L4
  SB -.->|"events"| L4

