# SevaForge Configuration
SEVAFORGE_ENVIRONMENT=development
SEVAFORGE_DEBUG=true
SEVAFORGE_LOG_LEVEL=INFO

# Auth
SEVAFORGE_JWT_SECRET=change-this-in-production-use-openssl-rand-hex-32

# LLM Providers (add your keys)
SEVAFORGE_ANTHROPIC_API_KEY=
SEVAFORGE_GOOGLE_API_KEY=
SEVAFORGE_DEFAULT_MODEL=claude-sonnet-4-20250514
SEVAFORGE_FALLBACK_MODEL=gemini-2.0-flash
SEVAFORGE_MAX_TOKENS=4096
SEVAFORGE_TEMPERATURE=0.3

# Database (Docker Compose sets these automatically)
SEVAFORGE_DATABASE_URL=postgresql+asyncpg://sevaforge:sevaforge@localhost:5432/sevaforge
SEVAFORGE_DB_POOL_MIN=2
SEVAFORGE_DB_POOL_MAX=20

# Redis
SEVAFORGE_REDIS_URL=redis://localhost:6379/0

# Observability
SEVAFORGE_OTEL_ENABLED=false
SEVAFORGE_OTEL_ENDPOINT=http://localhost:4317