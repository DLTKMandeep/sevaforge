---
title: "SevaForge v3.0 — Local Development Architecture"
---
graph TB
  %% ════════════════════════════════════════════════════════
  %% LAYER 1 — Client / Developer Interface
  %% ════════════════════════════════════════════════════════
  subgraph L1["🖥️ LAYER 1 — Client / Developer Interface"]
    direction LR
    CLI["forgeflow CLI\n(Click + Rich)"]
    IDE["VS Code\nTerminal Integration"]
    CICD_T["CI/CD Triggers\nGitHub Actions / GitLab"]
    API_C["REST API Clients\nPostman / curl"]
    CHAT["Slack / ChatOps\nWebhook Integration"]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 2 — Local Routing (no gateway in dev)
  %% ════════════════════════════════════════════════════════
  subgraph L2["🔀 LAYER 2 — CLI Routing / Command Parser"]
    direction LR
    CLICK["Click Command Groups\nscan | docker | terraform\nhelm | deploy | cost"]
    RICH["Rich Console\nProgress bars + Tables"]
    CONFIG_L["Config Loader\nforgeflow-config.yaml"]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 3 — Orchestration
  %% ════════════════════════════════════════════════════════
  subgraph L3["🎯 LAYER 3 — Orchestration"]
    direction LR
    MC["MissionControl\nPipeline Orchestrator\n(sequential + parallel)"]
    MR["ModelRouter\nLLM Traffic Manager\n(cost + latency routing)"]
    RAG["RAGPipeline\nVector Search + Hybrid\n(InMemory / pgvector)"]
    INTENT["Config / Intent Store\ndeployment-intent.yaml\n(.sevaforge/ directory)"]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 4 — Pipeline Agents
  %% ════════════════════════════════════════════════════════
  subgraph L4["🤖 LAYER 4 — Pipeline Agents (14 Specialized)"]
    direction LR
    PS["ProjectScanner\nLanguage detect\n+ LLM classify"]
    DA["DockerAgent\nDockerfile gen\n+ LLM optimize"]
    TA["TerraformAgent\nIaC generation\n+ LLM modules"]
    HA["HelmAgent\nK8s manifests\n+ LLM values"]
    CE["CostEstimator\nPricing calc\n+ LLM budget"]
    SS["SecurityScanner\nTrivy + Checkov\n+ LLM triage"]
    RB["RunbookAgent\nOps docs gen\n+ LLM author"]
    MORE["+ 7 More\nMonitoring, CI/CD\nCompliance, Net..."]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 5 — AI Gateway
  %% ════════════════════════════════════════════════════════
  subgraph L5["🧠 LAYER 5 — AI Gateway (ModelRouter)"]
    direction LR
    MR_SVC["ModelRouter Service\nCost-aware routing\nTrustScore gating"]
    GUARD["Guardrails\nToken budget\nSafety + grounding"]
    CACHE["Response Cache\nLLM dedup\nEmbedding cache"]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 6 — External AI Providers
  %% ════════════════════════════════════════════════════════
  subgraph L6["☁️ LAYER 6 — External AI Providers"]
    direction LR
    CLAUDE["Claude 3.5 Sonnet\nReasoning + Code Gen\n(via Anthropic API)"]
    GEMINI["Gemini 2.0 Pro\nLong-context analysis\n(via Google AI)"]
    FLASH["Gemini 2.0 Flash\nFast classify\n(via Google AI)"]
    EMBED["Embedding Models\ntext-embedding-004\n(768-dim vectors)"]
    LOCAL_LLM["CodeLlama / Ollama\nLocal inference\n(air-gapped option)"]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 7 — MCP Servers
  %% ════════════════════════════════════════════════════════
  subgraph L7["🔌 LAYER 7 — MCP Servers (stdio/SSE)"]
    direction LR
    FS_MCP["filesystem-mcp\nLocal file I/O\nProject artifacts"]
    DOCK_MCP["docker-mcp\nDocker Engine API\nBuild + push images"]
    TF_MCP["terraform-mcp\nTF CLI wrapper\nPlan / Apply / State"]
    VS_MCP["vector-store-mcp\nRAG operations\nIngest + Search"]
    EM_MCP["embedding-mcp\nText vectorization\nCode embeddings"]
    VX_MCP["vertex-ai-mcp\nLLM orchestration\nModel Garden API"]
    MORE_MCP["+ 3 MCPs\ngit, helm\nsecrets-mcp"]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 8 — Data & Vector Storage
  %% ════════════════════════════════════════════════════════
  subgraph L8["💾 LAYER 8 — Data & Vector Storage"]
    direction LR
    PG["PostgreSQL + pgvector\n(or InMemoryVectorStore)\nEmbeddings + metadata"]
    REDIS["Redis / In-Memory\nSession cache\nLLM response cache"]
    FS["Local Filesystem\n.sevaforge/ directory\nArtifacts + templates"]
    JSON_DB["JSON Files\nPipeline results\nCost tracking + audit"]
    DOTENV["dotenv / .env\nAPI keys + tokens\nLocal secrets"]
  end

  %% ════════════════════════════════════════════════════════
  %% LAYER 9 — Infrastructure
  %% ════════════════════════════════════════════════════════
  subgraph L9["⚙️ LAYER 9 — Infrastructure (Local Dev)"]
    direction LR
    PYTHON["Python 3.11+\nvenv / Poetry\nDependency mgmt"]
    DOCKER_E["Docker Engine\nLocal containers\nBuildKit"]
    TF_CLI["Terraform CLI\nLocal state\nProvider plugins"]
    GIT["Git\nVersion control\nPre-commit hooks"]
    NODE["Node.js (optional)\nMCP server runtime\nstdio transport"]
  end

  %% ════════════════════════════════════════════════════════
  %% FLOW CONNECTIONS
  %% ════════════════════════════════════════════════════════
  L1 --> L2
  L2 --> L3
  L3 --> L4
  L4 --> L5
  L5 --> L6
  L4 --> L7
  L7 --> L8
  L8 --> L9

  %% Cross-layer connections
  L3 -.->|"RAG context"| L8
  L5 -.->|"cached responses"| L8
  L7 -.->|"tool results"| L4

  %% ════════════════════════════════════════════════════════
  %% STYLING
  %% ════════════════════════════════════════════════════════
  classDef layer1 fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
  classDef layer2 fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
  classDef layer3 fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C
  classDef layer4 fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px,color:#4A148C
  classDef layer5 fill:#FCE4EC,stroke:#C62828,stroke-width:2px,color:#B71C1C
  classDef layer6 fill:#E0F7FA,stroke:#00838F,stroke-width:2px,color:#006064
  classDef layer7 fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#F57F17
  classDef layer8 fill:#E8EAF6,stroke:#283593,stroke-width:2px,color:#1A237E
  classDef layer9 fill:#ECEFF1,stroke:#37474F,stroke-width:2px,color:#263238

  class CLI,IDE,CICD_T,API_C,CHAT layer1
  class CLICK,RICH,CONFIG_L layer2
  class MC,MR,RAG,INTENT layer3
  class PS,DA,TA,HA,CE,SS,RB,MORE layer4
  class MR_SVC,GUARD,CACHE layer5
  class CLAUDE,GEMINI,FLASH,EMBED,LOCAL_LLM layer6
  class FS_MCP,DOCK_MCP,TF_MCP,VS_MCP,EM_MCP,VX_MCP,MORE_MCP layer7
  class PG,REDIS,FS,JSON_DB,DOTENV layer8
  class PYTHON,DOCKER_E,TF_CLI,GIT,NODE layer9
